#!/bin/bash
# Транскрибатор ШЧСМ — превратить аудио в текст (macOS)
# Способ 1 (обычный): положите аудио в папку «Положите аудио сюда» на Рабочем столе
#                     и дважды щёлкните этот файл.
# Способ 2: перетащите аудиофайл(ы) прямо на этот значок.
cd "$(dirname "$0")"

# PATH при двойном клике из Finder урезан — оба пути Homebrew явно
# (/opt/homebrew — Apple Silicon, /usr/local — Intel).
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# 🔴 ЛОКАЛЬ ОБЯЗАТЕЛЬНА — ОТ НЕЁ ЗАВИСИТ ПОМЕТКА «ПРОВЕРЬТЕ ЭТИ МЕСТА».
#
# Пометка ищет фразы-выдумки через `grep -i`. БЕЗ ЛОКАЛИ grep -i НЕ СВОРАЧИВАЕТ
# РЕГИСТР КИРИЛЛИЦЫ: находит только точное совпадение, а «ПРОДОЛЖЕНИЕ СЛЕДУЕТ»
# и «продолжение следует» проходят мимо. Замер 26.08 на трёх регистрах в одном
# файле: без локали найдено 1 из 3, с любой UTF-8 — 3 из 3.
#
# ⚠️ Finder при двойном клике локаль НЕ передаёт. То есть отказ пометки —
# не редкий случай, а обычный способ запуска для преданного.
#
# Почему это важнее, чем кажется: словарь-подсказка остаётся в конвейере, значит
# машина по-прежнему может выдумать текст там, где не расслышала. Пометка —
# ЕДИНСТВЕННОЕ, что говорит вычитчику «здесь послушай оригинал». Молчащая
# пометка означает, что выдумка уходит в текст как слово Гуру.
#
# Годится ЛЮБАЯ UTF-8, не обязательно русская — проверено на всех четырёх.
for _loc in ru_RU.UTF-8 en_US.UTF-8 C.UTF-8 UTF-8; do
  if locale -a 2>/dev/null | grep -qx "$_loc"; then export LC_ALL="$_loc"; break; fi
done
[ -z "${LC_ALL:-}" ] && export LC_ALL="C.UTF-8"
unset _loc

HOME_DIR="$HOME/.transcriber-shchsm"
MODEL="$HOME_DIR/models/ggml-large-v3-turbo.bin"
GLOSSARY="$HOME_DIR/glossary.txt"

# Простые папки на Рабочем столе — вход и результат отдельно
BASE_DIR="$HOME/Desktop/Транскрибатор ШЧСМ"
INBOX="$BASE_DIR/Положите аудио сюда"
OUTBOX="$BASE_DIR/Готовые тексты"
mkdir -p "$INBOX" "$OUTBOX"

WCLI="$(command -v whisper-cli || true)"

if [ ! -f "$MODEL" ]; then
  echo "❌ Сначала запустите «Установить.command»"; read -p "Enter…" _; exit 1
fi
if [ -z "$WCLI" ]; then
  echo "❌ Движок распознавания не найден. Запустите «Установить.command» ещё раз."
  read -p "Enter…" _; exit 1
fi
if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "❌ Конвертер аудио (ffmpeg) не найден. Запустите «Установить.command» ещё раз."
  read -p "Enter…" _; exit 1
fi
# Без словаря имена ачарьев распознаются неверно — молчать об этом нельзя
if [ ! -s "$GLOSSARY" ]; then
  echo "❌ Не найден словарь имён и терминов."
  echo "   Запустите «Установить.command» ещё раз — без словаря имена будут искажены."
  read -p "Enter…" _; exit 1
fi

# короткий prompt из глоссария — влияет на написание имён/терминов.
# ⚠️ РАЗДЕЛИТЕЛЬ «. » (точка+пробел) — НЕ запятая. Проверено на РЕАЛЬНОМ аудио лекций 20.07:
#    whisper копирует СТИЛЬ промпта. Список через запятую → расшифровка идёт сплошняком
#    без точек и теряет слова (в тесте пропало «Я»), что мучительно для человеческой вычитки.
#    Точка+пробел → нормальные предложения И лучшее распознавание пранамы.
# ⚠️ ОКНО 16, первые ДВЕ строки — пара, разрывать нельзя:
#    «Джай…Ки Джай» (произносимый возглас) + «Харе Кришна» (маха-мантра).
#    Поодиночке они ИНТЕРФЕРИРУЮТ: возглас без маха-мантры превращает «Харе Кришна»
#    в «Харина Кришна» (порча святого имени). Заданные ОБЕ — распознаются обе.
#    Вредит не длина сама по себе, а непокрытая пара фонетически близких форм.
# 🔴 ОКНО СЛОВАРЯ — 6 СТРОК, НЕ 16. Длина подсказки влияет не только на
# написание имён: чем она длиннее, тем чаще движок срывается в повтор и теряет
# речь. Замер 21.09.2026 на лекции 20130619 (13 мин), одна и та же запись:
#     16 строк (как раздавалось):  167 слов,  92% мусора,  2 имени
#      6 строк:                   1468 слов,  29% мусора, 23 имени
#      без подсказки:             1686 слов,  32% мусора, 15 имён
# ⚠️ «Слов» здесь — ВСЕГО. По позднему замеру сессии диктовщика чистых слов (без повторов и титров)
#    в тех же трёх вариантах: 79 / 972 / 958. Определения «мусора» в двух замерах разные, поэтому
#    проценты и чистые слова между собой не сводятся (1468 × 71% ≠ 972) — не пересчитывать одно в другое.
#    Оба замера — со слов, мной не воспроизводились.
# То есть длинная подсказка НЕ защищает имена, а уничтожает их вместе с речью:
# ошибаться негде там, где текста нет. Искажённых написаний не было ни в одном
# варианте. Прежнее «окно 16 проверено» проверяло ИМЕНА и не отвечало на вопрос
# о полноте расшифровки — верная проверка не того вопроса.
# Сброс контекста (-mc 0) тоже лечит срыв, но подсказку при этом отключает
# целиком (проверено: прогоны с подсказкой 6 и 16 строк совпали ПОБАЙТНО),
# поэтому выбран короткий словарь, а не сброс.
PROMPT=$(grep -v '^#' "$GLOSSARY" | grep -v '^$' | head -6 | awk '{printf "%s. ", $0}' | sed 's/ $//')

# собрать список файлов: аргументы (перетаскивание) ИЛИ папка «Положите аудио сюда»
FILES=("$@")
if [ ${#FILES[@]} -eq 0 ]; then
  shopt -s nullglob
  FILES=("$INBOX"/*.{mp3,m4a,ogg,opus,wav,mp4,aac,flac,MP3,M4A,OGG,WAV,MP4,AAC,FLAC,OPUS})
fi
if [ ${#FILES[@]} -eq 0 ]; then
  echo "Пока нечего распознавать."
  echo ""
  echo "Положите аудио (лекцию, голосовое, запись) в папку:"
  echo "   Рабочий стол → «Транскрибатор ШЧСМ» → «Положите аудио сюда»"
  echo "и запустите этот файл ещё раз."
  open "$INBOX" 2>/dev/null
  read -p "Enter — закрыть…" _; exit 0
fi

echo "🎙  Распознаю ${#FILES[@]} файл(ов)."
echo "    Время зависит от длины записи: короткая — минуты, часовая лекция — от 40 минут."
echo ""
OK=0
for f in "${FILES[@]}"; do
  [ -e "$f" ] || continue
  name="$(basename "$f")"     # имя с расширением
  stem="${name%.*}"           # имя без расширения
  out="$OUTBOX/${stem} (транскрипция).txt"
  echo "→ $name …"
  tmp="/tmp/tsh_$$.wav"
  ffmpeg -y -i "$f" -ar 16000 -ac 1 -c:a pcm_s16le "$tmp" 2>/dev/null || { echo "   ⚠️ не удалось прочитать файл, пропускаю"; continue; }
  # 🔴 РЯДОМ С ТЕКСТОМ КЛАДЁМ СУБТИТРЫ (.srt) — без них дальше ничего не сделать.
  #
  # Текст остаётся БЕЗ таймкодов (-nt): его читает вычитчик, и таймкоды внутри
  # мешают чтению. Но без времени невозможно ни нарезать фрагмент, ни сделать
  # субтитры, ни — что важнее всего — ПОСЛУШАТЬ спорное место в оригинале,
  # а канон требует именно слушать, когда машина могла ошибиться.
  #
  # Поэтому два файла, а не выбор между ними: «… (транскрипция).txt» для чтения
  # и «… (транскрипция).srt» для работы со временем. Проверено: whisper-cli
  # отдаёт оба за один проход, второй проход не нужен.
  srt_of="${out%.txt}"

  # 🔴 ЧЕСТНОЕ ВРЕМЯ И ЖИВОЙ ПРИЗНАК РАБОТЫ.
  #
  # Было: экран замирал молча на всё время распознавания. На часовой лекции это
  # 40 минут и больше, и для человека это неотличимо от зависшего компьютера —
  # он выключает и решает, что программа сломана.
  #
  # Технический вывод whisper (stderr, ~80 строк про load_backend и ggml) на
  # экран НЕ пускаем: он пугает сильнее молчания. Показываем свой признак —
  # точку раз в 20 секунд, этого хватает, чтобы видеть «работа идёт».
  dlit=$(ffprobe -v quiet -show_entries format=duration -of csv=p=0 "$f" 2>/dev/null | cut -d. -f1)
  if [ -n "$dlit" ] && [ "$dlit" -gt 0 ] 2>/dev/null; then
    # Осторожная оценка: на ноутбуке без ускорителя бывает дольше самой записи.
    minut=$(( dlit / 60 ))
    if [ "$minut" -lt 1 ]; then
      echo "   запись короткая — это быстро."
    elif [ "$minut" -lt 10 ]; then
      echo "   запись ${minut} мин — распознавание займёт примерно столько же."
    else
      # На длинных записях честнее назвать худший случай: человек планирует время,
      # а не сверяет секундомер. Обещание «несколько минут» на часовой лекции —
      # то, из-за чего инструмент считают сломанным.
      echo "   запись ${minut} мин — распознавание займёт примерно столько же или дольше."
      echo "   на ноутбуке без ускорителя час записи может считаться час-полтора."
    fi
  else
    echo "   идёт распознавание. На час записи уходит от 40 минут."
  fi
  echo "   можно свернуть окно и заниматься своими делами, только не прерывайте."

  # 🔴 БЕЗ -nt: ЭТОТ КЛЮЧ ТЕРЯЕТ РЕЧЬ, А НЕ ПРОСТО УБИРАЕТ ТАЙМКОДЫ.
  #
  # Документирован как «не печатать таймкоды», но на деле меняет само
  # распознавание: whisper порождает таймкод-токены В ТОЙ ЖЕ последовательности,
  # что и слова, и подавление их меняет путь декодирования.
  #
  # Замер 27.08 на 4 минутах речи, один файл, разница только в этом ключе:
  #     с -nt : 301 слово
  #     без   : 477 слов      ← ТЕРЯЛОСЬ 176 СЛОВ, больше трети
  # «это массово запустить» превращалось в «спустить», «Арджуна составил» —
  # в «у торджу нас оставил». На санскритских местах расхождения ещё гуще.
  #
  # ⚠️ И архивная очередь работает БЕЗ -nt. То есть преданный, расшифровав
  # ту же лекцию нашим инструментом, получал текст, отличный от архивного —
  # и никто из двух не помечен как правильный.
  #
  # Поэтому распознаём без -nt (полный текст), а таймкоды срезаем ПОСТФАКТУМ.
  # Проверено: совпадение с архивным способом 100.0% слово в слово.
  # 🔴 -mc 0 — СБРОС КОНТЕКСТА МЕЖДУ КУСКАМИ. Без него движок уносит собственный
  # бред из одного куска в следующий и укатывается в цикл, теряя речь целиком.
  #
  # ЗАМЕР 21.09.2026, ДВЕ РЕАЛЬНЫЕ ЛЕКЦИИ, чистые слова (без повторов и титров):
  #                        13 мин          43 мин       имён 13/43 мин
  #   как раздавалось        79            4013             2 / 45
  #   -mc 0                 939            4531            19 / 82
  #   -mc 96                984            3940            22 / 52
  # На первой лекции лучшим выглядел -mc 96, на второй он стал худшим из лечащих.
  # Порядок вариантов МЕНЯЕТСЯ от записи к записи — значит «подобрать хорошее
  # число» нельзя, это подгонка под конкретный файл. -mc 0 выигрывает на обеих.
  #
  # ⚠️ ВАЖНОЕ СЛЕДСТВИЕ: при -mc 0 подсказка --prompt движком НЕ ПРИМЕНЯЕТСЯ.
  # Проверено побайтно: прогоны с подсказкой в 6 и в 16 строк дали одинаковый
  # файл. То есть словарь имён больше не влияет на распознавание — и это, вопреки
  # ожиданию, УЛУЧШИЛО имена: 82 против 45 на длинной лекции. Подсказка не
  # защищала написание, она роняла расшифровку, а имён нет там, где нет текста.
  # Вызов --prompt оставлен намеренно: он безвреден и сразу заработает, если
  # когда-нибудь появится причина убрать -mc 0.
  "$WCLI" -m "$MODEL" -l ru -np -mc 0 --prompt "$PROMPT" -f "$tmp" \
          -osrt -of "$srt_of" 2>/dev/null > "$out.raw" &
  wpid=$!
  while kill -0 "$wpid" 2>/dev/null; do printf "."; sleep 20; done
  wait "$wpid"; wcode=$?
  echo
  rm -f "$tmp"

  # Таймкоды срезаем здесь, а не ключом при распознавании (см. выше).
  # Вычитчик получает чистый текст, .srt со временем лежит рядом.
  if [ -s "$out.raw" ]; then
    sed 's/^\[[^]]*\][[:space:]]*//' "$out.raw" | sed 's/^[[:space:]]*//' | grep -v '^$' > "$out"
  fi
  rm -f "$out.raw"

  # 🔴 ПРОВЕРЯЕМ, ЧТО РАСПОЗНАВАНИЕ ВООБЩЕ УДАЛОСЬ.
  # Было: «ГОТОВО» печаталось всегда, даже когда распознаватель упал, — человек
  # шёл в папку за текстом, а там пусто или обрывок. Молчаливый провал хуже
  # честной ошибки: он тратит время и подрывает доверие к инструменту.
  if [ "$wcode" -ne 0 ] || [ ! -s "$out" ]; then
    echo "   ⚠️ не получилось распознать «$name»."
    echo "      Файл цел? Формат поддерживается? Если повторится — напишите Арджуне."
    rm -f "$out" "${srt_of}.srt"
    continue
  fi
  # UTF-8-нормализация: whisper иногда пишет невалидный байт (диагностика Санкаршана: 0xbb в хвосте) →
  # чистим битые UTF-8 последовательности, НЕ трогая сам текст (iconv -c отбрасывает только невалидное).
  iconv -c -f UTF-8 -t UTF-8 "$out" > "$out.u8" 2>/dev/null && mv "$out.u8" "$out"
  if [ -s "$out" ]; then
    # Машинные вставки: whisper на тишине дописывает субтитровый мусор.
    # ⛔ НЕ УДАЛЯЕМ — только ПОМЕЧАЕМ. Проверено на 47 реальных лекциях:
    #    «Продолжение следует» звучит 13 раз, и часть из них — подлинная речь
    #    («мы закончим нашу сегодняшнюю лекцию. Продолжение следует»), а повтор
    #    фразы 4+ раз — это КИРТАН (повтор святого имени), не мусор.
    #    Пропущенный мусор вычитчик увидит и уберёт; молча удалённую речь — уже нет.
    NOTES=""
    # +4 строки: явные YouTube/whisper-артефакты на тишине по краям (диагностика Санкаршана
    #  19.01.2019: «Субтитры создавал DimaTorzok» ×21 в начале, зацикленный «KERCer» ×13 в конце).
    #  Это НЕ киртан (латиница/чужой мусор) → безопасно помечать. Философия mark-не-delete цела.
    for junk in "Продолжение следует" "Спасибо за просмотр" "Подписывайтесь на канал" \
                "Не забудьте подписаться" "Субтитры" "Редактор субтитров" \
                "DimaTorzok" "KERCer" "Субтитры создавал" "Добро пожаловать в"; do
      c=$(grep -oi "$junk" "$out" 2>/dev/null | wc -l | tr -d ' ')
      [ "${c:-0}" -gt 0 ] && NOTES="${NOTES}  • «$junk» — ${c} раз(а)
"
    done
    if [ -n "$NOTES" ]; then
      {
        printf '\n─────────────────────────────\n'
        printf '⚠️ ПРОВЕРЬТЕ ЭТИ МЕСТА при вычитке (сам текст НЕ изменён):\n'
        printf '%s' "$NOTES"
        printf 'Чаще всего это музыка или киртан-интро в начале и конце — программа не\n'
        printf 'распознаёт пение и дописывает своё; настоящая лекция начинается после них.\n'
        printf 'Такие фразы программа иногда дописывает сама на тишине — но лектор мог\n'
        printf 'сказать это и по-настоящему. Решает человек, не программа.\n'
      } >> "$out"
      echo "   ℹ️  добавлена пометка о возможных машинных вставках"
    fi
    # 🔴 «ГОТОВО» ТОЛЬКО ПОСЛЕ ПРОВЕРКИ ПОЛНОТЫ, а не по коду возврата.
    # Дефект, который нашла Kauśála 21.09: при срыве движка распознаватель
    # возвращает 0, файл непустой, и человек получал зелёную галочку на тексте,
    # где нет четырёх пятых лекции. Код возврата отвечает на вопрос «программа
    # не упала», а не «речь расшифрована». Разные вопросы.
    # Мера — плотность речи: слов на минуту ЗАПИСИ. У живой речи 90–130.
    # На сорванной расшифровке 20130619 было 12. Порог 45 взят с запасом вниз,
    # чтобы медленная речь и долгие паузы не поднимали ложной тревоги.
    wrds=$(wc -w < "$out" | tr -d ' ')
    wpm=0
    [ "${dlit:-0}" -gt 60 ] && wpm=$(( wrds * 60 / dlit ))
    # Вторая улика — одна строка, занявшая треть файла: это цикл вставок.
    lines=$(grep -c . "$out" 2>/dev/null || echo 0)
    toprep=$(sort "$out" 2>/dev/null | uniq -c | sort -rn | head -1 | awk '{print $1+0}')
    repshare=0
    [ "${lines:-0}" -gt 10 ] && repshare=$(( toprep * 100 / lines ))
    if { [ "$wpm" -gt 0 ] && [ "$wpm" -lt 45 ]; } || [ "$repshare" -ge 30 ]; then
        echo "   🔴 РАСШИФРОВКА НЕПОЛНАЯ: ${stem}"
        echo "      $wrds слов за $(( ${dlit:-0} / 60 )) мин — это $wpm слов в минуту (у сплошной речи 90–130; у пения и пауз намного меньше)."
        [ "$repshare" -ge 30 ] && echo "      Одна и та же строка занимает $repshare% файла — либо движок зациклился, либо это настоящий киртан: проверьте на слух."
        echo "      Файл сохранён, но ОТДАВАТЬ ВЫЧИТЧИКУ КАК ЕСТЬ НЕЛЬЗЯ, пока вы не прослушали начало записи: либо движок потерял часть речи, либо здесь пение и паузы."
        echo "      Если речь в записи есть, а в тексте её нет — попробуйте ещё раз; если повторится — напишите нам, приложив имя файла."
    else
        echo "   ✅ готово: ${stem} (транскрипция).txt  —  $wrds слов, $wpm слов/мин"
    fi
    OK=$((OK+1))
  else
    echo "   ⚠️ текст не получился (тишина или повреждённый файл)"
    rm -f "$out"
  fi
done

echo ""
echo "══════════════════════════════════════════════"
echo " Готово: $OK текст(ов)."
echo " Забрать: Рабочий стол → «Транскрибатор ШЧСМ» → «Готовые тексты»"
echo " Имя файла — как у аудио, с пометкой «(транскрипция)»."
echo "══════════════════════════════════════════════"
open "$OUTBOX" 2>/dev/null
read -p "Enter — закрыть…" _
